#!/bin/sh
# Segunda red por si algún commit se hizo con --no-verify: revisa todo el árbol y el historial.
set -e
command -v gitleaks >/dev/null 2>&1 || { echo "Falta gitleaks: brew install gitleaks"; exit 1; }
bun scripts/check-public-repo.ts --all
gitleaks git --redact --no-banner --config .gitleaks.toml .
