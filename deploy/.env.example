# Configuración del servidor. Copiá este archivo a .env (cp .env.example .env) y completalo.
# .env NUNCA se commitea: tiene el token de DuckDNS.
# Valores sin espacios ni comillas.

# --- Imágenes (GHCR) ---------------------------------------------------------------------------
# Dueño del repo en GitHub, EN MINÚSCULAS (usuario u organización).
GHCR_OWNER=usuario-de-ejemplo
# Versión a correr: latest, o sha-xxxxxxx para fijar una. Para volver atrás una sola vez:
# TAG=sha-xxxxxxx ./deploy.sh  (pero el timer de actualización vuelve a latest si TAG no está acá).
TAG=latest

# --- Dominio y HTTPS ---------------------------------------------------------------------------
# Subdominio de DuckDNS apuntando a la IP LOCAL del servidor (p. ej. 192.168.0.10).
DOMAIN=ejemplo.duckdns.org
# Token de https://www.duckdns.org (arriba de todo, al iniciar sesión).
DUCKDNS_TOKEN=

# --- Discos (rutas en el SERVIDOR) -------------------------------------------------------------
# Tienen que existir y ser del usuario 1000:1000 (sudo chown -R 1000:1000 <ruta>).
# Rápido (ideal SSD): base de datos, miniaturas y versiones medianas.
HOST_FAST_PATH=/srv/galeria/rapido
# Grande (puede ser HDD): originales y videos convertidos. Con un solo disco puede ser el mismo que el rápido.
HOST_BULK1_PATH=/srv/galeria/disco1
# Más discos: HOST_BULK2_PATH=/mnt/disco2 (y sumar el montaje en docker-compose.yml, ver ahí).

# Discos grandes ADENTRO del contenedor, separados por comas: /data/bulk1, /data/bulk2, ...
# Uno por cada HOST_BULKn_PATH. Lo nuevo va al que tenga más espacio libre.
DATA_BULK_PATHS=/data/bulk1
# (DATA_FAST_PATH es fijo en /data/fast y lo pone docker-compose.yml.)

# --- Procesamiento -----------------------------------------------------------------------------
# GPU NVIDIA para videos: auto (la usa si hay) u off (siempre CPU).
GPU=auto
# Fotos procesadas en paralelo. Bajalo si el servidor es chico.
WORKER_IMAGE_CONCURRENCY=4
# Videos convertidos en paralelo.
WORKER_VIDEO_CONCURRENCY=1

# --- Varios ------------------------------------------------------------------------------------
# Alerta en Administración cuando un disco pasa este porcentaje de uso.
DISK_ALERT_PERCENT=85
# debug | info | warn | error
LOG_LEVEL=info

# Ya vienen bien en la imagen; solo cambiarlos si sabés para qué:
# PORT=3000
# WEB_DIST=/app/apps/web/dist
# GEONAMES_PATH=/opt/geonames/cities500.txt
# APP_VERSION la pone el build de la imagen.
